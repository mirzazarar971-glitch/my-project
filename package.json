{
  "name": "devtools-hub",
  "version": "1.0.0",
  "description": "A private, all-in-one developer tools platform",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "node scripts/generate-sitemap.js && npm --prefix client run build",
    "start": "node server/index.js",
    "test": "npm --prefix client run test && node --test server/tests/*.test.js"
  },
  "keywords": [
    "developer-tools",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2"
  }
}
