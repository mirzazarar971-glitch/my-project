NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/devtools_hub
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Optional: on first boot, create this administrator only if the email is unused.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use_a_unique_password_with_at_least_12_characters

# Set this to the public frontend origin before production builds.
VITE_SITE_URL=https://your-domain.example

# Optional public email used by the Contact Us page.
# VITE_CONTACT_EMAIL=support@your-domain.example
