NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/devtools_hub
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# On startup, create or synchronize the single supported administrator account.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use_a_unique_password_with_at_least_12_characters

# Anonymous analytics. IDs are HMAC-hashed with this stable secret before storage.
# If omitted, JWT_SECRET is used with a separate hashing domain.
# ANALYTICS_HASH_SECRET=replace_with_a_different_random_secret_of_32_characters
ANALYTICS_RETENTION_DAYS=180
ANALYTICS_SESSION_TIMEOUT_MINUTES=30
ANALYTICS_ACTIVE_WINDOW_SECONDS=60

# Optional country reporting. Configure only when a trusted reverse proxy strips
# incoming copies of this header and supplies its own country code.
# Supported: cf-ipcountry or x-vercel-ip-country
# ANALYTICS_COUNTRY_HEADER=cf-ipcountry

# Optional Google Search Console read-only integration.
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REDIRECT_URI=https://api.example.com/api/admin/search-console/callback
# GSC_SITE_URL=https://www.example.com/
# Generate the 32-byte AES-256-GCM key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# GSC_TOKEN_ENCRYPTION_KEY=

# Set this to the public frontend origin before production builds.
VITE_SITE_URL=https://your-domain.example

# Optional public email used by the Contact Us page.
# VITE_CONTACT_EMAIL=support@your-domain.example
